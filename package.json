{
  "name": "kittu-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run component:sync && tsc -b && vite build && npm run prerender && npm run seo:audit",
    "prerender": "node --import ./scripts/register-assets.mjs --import tsx scripts/prerender.ts",
    "registry:generate": "tsx scripts/generate-registry.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "component:sync": "tsx scripts/generate-registry.ts && tsx scripts/validate-registry.ts",
    "component:new": "tsx scripts/component-new.ts",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "seo:llms": "tsx scripts/generate-llms.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "description": "Independent, tactile React components. Copy the source and make it yours.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaitanay-kumar/kittu-ui.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  }
}
