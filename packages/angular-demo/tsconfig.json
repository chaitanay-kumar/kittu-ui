{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true,
    "experimentalDecorators": true, "outDir": ".generated", "rootDir": "src",
    "paths": { "kit-ui-angular": ["../angular/dist"] }
  },
  "angularCompilerOptions": { "strictTemplates": true, "compilationMode": "full" },
  "include": ["src/**/*.ts"]
}
